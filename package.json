{
  "name": "xiangyue-erp-desktop",
  "version": "1.0.0",
  "private": true,
  "author": "ab112",
  "description": "Xiangyue ERP desktop management app",
  "main": "electron-main.js",
  "scripts": {
    "desktop:start": "electron . --dev",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.xiangyue.erp.management",
    "productName": "Xiangyue ERP",
    "directories": {
      "output": "dist-desktop-new-3"
    },
    "files": [
      "index.html",
      "splash.html",
      "xiang.html",
      "yan.html",
      "yi.html",
      "you.html",
      "css/**/*",
      "js/**/*",
      "manifest.json",
      "electron-main.js",
      "electron-preload.js"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ab11252000/ERP.git"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ab11252000/ERP/issues"
  },
  "homepage": "https://github.com/ab11252000/ERP#readme"
}
